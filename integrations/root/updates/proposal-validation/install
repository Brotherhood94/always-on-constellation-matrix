#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ $EUID == 0 && $# == 0 ]] || { echo 'Run this installer from the macai root console.' >&2; exit 1; }
release_dir=$(cd -- "$(dirname -- "$0")" && pwd)
project=/opt/matrix-root-operations
compose=(docker compose --project-directory "$project" --profile active)
export COMPOSE_IGNORE_ORPHANS=true COMPOSE_REMOVE_ORPHANS=false
exec 9>/run/lock/matrix-root-operations.lock
flock -n 9 || { echo 'Another Root operator command is running.' >&2; exit 1; }

[[ -f "$project/approved-scripts.json" && -f "$project/install-complete" &&
   ! -L "$project" && $(stat -c '%u:%a' "$project") == 0:700 ]] ||
  { echo 'The Root reviewed scripts release is required.' >&2; exit 1; }
if cmp -s -- "$release_dir/agent.mjs" "$project/app/agent.mjs" &&
   cmp -s -- "$release_dir/protocol.mjs" "$project/app/protocol.mjs"; then
  echo 'Root proposal validation is already installed.'
  exit 0
fi
if ! (cd -- "$project" && sha256sum --check --status -- "$release_dir/baseline.sha256"); then
  echo 'The installed Root files differ from the release baseline.' >&2
  exit 1
fi

container=$("${compose[@]}" ps -q gateway)
[[ -n $container ]] || { echo 'Start the installed Root gateway before applying this update.' >&2; exit 1; }
for name in agent.mjs protocol.mjs; do
  docker exec -i "$container" node --input-type=module --check < "$release_dir/$name"
done

backup=$(mktemp -d "$project/proposal-validation.XXXXXXXX")
cp -p -- "$project"/app/{agent.mjs,protocol.mjs} "$backup/"
restart_gateway() {
  "${compose[@]}" up -d --no-build --no-deps --force-recreate --wait --wait-timeout 100 gateway
}

rollback() {
  local status=$?
  trap - EXIT
  if (( status != 0 )); then
    cp -p -- "$backup"/{agent.mjs,protocol.mjs} "$project/app/"
    restart_gateway || echo 'Check the restored Root gateway.' >&2
    echo "Previous gateway files are at $backup." >&2
  fi
  exit "$status"
}
trap rollback EXIT
"${compose[@]}" stop gateway
install -m 0644 -- "$release_dir"/{agent.mjs,protocol.mjs} "$project/app/"
restart_gateway
trap - EXIT
echo "Root proposal validation is ready for new requests. Previous gateway files are at $backup."
