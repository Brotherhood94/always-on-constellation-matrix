#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

[[ $EUID == 0 && $# == 0 ]] || { echo 'Run this installer from the macai root console.' >&2; exit 1; }
release_dir=$(cd -- "$(dirname -- "$0")" && pwd)
project=/opt/matrix-root-operations
broker=matrix-root-operations-broker
compose=(docker compose --project-directory "$project" --profile active)
export COMPOSE_IGNORE_ORPHANS=true COMPOSE_REMOVE_ORPHANS=false
files=(agent.mjs protocol.mjs broker.py acp.mjs)
flag=$project/approved-scripts.json
exec 9>/run/lock/matrix-root-operations.lock
flock -n 9 || { echo 'Another Root operator command is running.' >&2; exit 1; }

[[ -f "$project/install-complete" && ! -L "$project" && $(stat -c '%u:%a' "$project") == 0:700 ]] ||
  { echo 'The expected Root installation is required.' >&2; exit 1; }
systemctl is-active --quiet "$broker.socket"
if [[ -f "$flag" ]]; then
  for name in "${files[@]}"; do
    cmp -s -- "$release_dir/$name" "$project/app/$name" ||
      { echo 'A different reviewed-script release is already installed.' >&2; exit 1; }
  done
  echo 'Root reviewed scripts are already installed.'
  exit 0
fi
if ! (cd -- "$project" && sha256sum --check --status -- "$release_dir/baseline.sha256"); then
  echo 'The installed Root files differ from the release baseline.' >&2
  exit 1
fi

port=$(docker compose --project-directory /opt/matrix-stack port synapse 8008)
if [[ ! $port =~ ^127\.0\.0\.1:([1-9][0-9]{0,4})$ ]] || (( BASH_REMATCH[1] > 65535 )); then
  echo 'Expected a single Synapse client port on IPv4 loopback.' >&2
  exit 1
fi
matrix_port=${BASH_REMATCH[1]}
container=$("${compose[@]}" ps -q gateway)
[[ -n $container ]] || { echo 'Start the installed Root gateway before applying this update.' >&2; exit 1; }
for name in agent.mjs protocol.mjs acp.mjs; do
  docker exec -i "$container" node --input-type=module --check < "$release_dir/$name"
done
python3 -B - "$release_dir/broker.py" <<'PY'
import ast
from pathlib import Path
import sys

path = Path(sys.argv[1])
ast.parse(path.read_text(), filename=str(path))
PY

backup=$(mktemp -d "$project/reviewed-scripts.XXXXXXXX")
cp -p -- "$project"/app/{agent.mjs,protocol.mjs,broker.py,acp.mjs} "$project/root-profile.json" "$backup/"
restart_gateway() {
  "${compose[@]}" up -d --no-build --no-deps --force-recreate --wait --wait-timeout 100 gateway
}

changed=0
catalog_attempted=0
rollback() {
  local status=$?
  trap - EXIT
  if (( status != 0 )); then
    if (( changed )); then
      cp -p -- "$backup"/{agent.mjs,protocol.mjs,broker.py,acp.mjs} "$project/app/"
      cp -p -- "$backup/root-profile.json" "$project/"
      rm -f -- "$flag"
      systemctl restart "$broker.service" || echo 'Check the restored Root broker.' >&2
      if (( catalog_attempted )); then
        python3 -B "$project/catalog.py" root "$project" || echo 'Check the restored Root catalog entry.' >&2
      fi
    fi
    restart_gateway || echo 'Check the restored Root gateway.' >&2
    echo "Previous files are at $backup." >&2
  fi
  exit "$status"
}
trap rollback EXIT
"${compose[@]}" stop gateway
python3 -B - "$project/execution/execution.sqlite3" <<'PY'
from pathlib import Path
import sqlite3
import sys

path = Path(sys.argv[1])
if path.exists():
    with sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=3) as db:
        if db.execute("SELECT 1 FROM audit WHERE outcome='running' LIMIT 1").fetchone():
            raise SystemExit('An approved Root operation is running. Retry after its receipt.')
PY

changed=1
install -m 0644 -- "$release_dir"/{agent.mjs,protocol.mjs,broker.py,acp.mjs} "$project/app/"
printf '{"matrix_port":%s}\n' "$matrix_port" > "$flag"
python3 -B - "$project/root-profile.json" <<'PY'
import json
from pathlib import Path
import sys

path = Path(sys.argv[1])
profile = json.loads(path.read_text())
capability = next(entry for entry in profile['capabilities'] if entry['code'] == 'host-administration')
capability['description'] = 'Propose and execute reviewed administrative scripts on macai, and report the result in the original Agents thread.'
profile['limits'] = 'Every operation requires a fresh vote from the configured operator in Root Operations on the exact script or fixed command. Send purpose, constraints and verification. Keep credentials out of the request.'
path.write_text(json.dumps(profile, indent=2) + '\n')
PY
systemctl restart "$broker.service"
systemctl is-active --quiet "$broker.service"
catalog_attempted=1
python3 -B "$project/catalog.py" root "$project"
restart_gateway
trap - EXIT
echo "Root reviewed scripts are ready for new requests. Previous files are at $backup."
