[Unit]
Description=Root Agent approved host execution
Requires=matrix-root-operations-broker.socket
After=matrix-root-operations-broker.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
Slice=matrix-workload.slice
ExecStart=/usr/bin/python3 -B /opt/matrix-root-operations/app/broker.py /opt/matrix-root-operations/config.json /opt/matrix-root-operations/execution /opt/matrix-root-operations/operations.json
NoNewPrivileges=yes
KillMode=control-group
Restart=on-failure
