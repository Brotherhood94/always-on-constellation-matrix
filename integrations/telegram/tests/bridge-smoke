  worker.kill('SIGSTOP');
  const now = Date.now();
  assert.equal(store.record({room:portal,event:'$fixture-inbound',author:'remote',body:'Fixture only',ts:now}, now), true);
  assert.equal(store.command({ room:controlRoom, sender:b.user_id, event:'$fixture-draft', encrypted:true },
    { action:'draft', binding:'pilot', source:'$fixture-inbound' }, { controlRoom, owner:b.user_id }, now), true);
  const draft = store.saveCandidate(store.nextWork(now), 'A synthetic Telegram draft.', now);
  worker.kill('SIGCONT');

  let review;
  const approve = reviewAnswer(store.draft(draft), 'approve');
  const reject = reviewAnswer(store.draft(draft), 'reject');
  await waitFor(() => {
    review = store.get('SELECT event FROM draft_review WHERE draft=?', draft);
    return review;
  }, 'the connector to post a review poll');
  await waitFor(async () => {
    const sync = await reader.sync(controlCursor, 0);
    controlCursor = sync.next_batch;
    let usable = false;
    await reader.applySync(sync, async (roomId, event, encrypted, failed) => {
      if (roomId === controlRoom && event.event_id === review.event && encrypted && !failed) {
        assert.equal(event.type, pollStart);
        assert.deepEqual(event.content[pollStart].answers.map(answer => answer.id), [approve, reject]);
        assert.deepEqual(event.content[pollStart].answers.map(answer => answer['org.matrix.msc1767.text']), ['✅ Accept', '❌ Decline']);
        usable = true;
      }
    });
    return usable;
  }, 'the owner to receive and decrypt both review options');

  await spaceClient.doRequest('PUT', root + '/rooms/' + encodeURIComponent(controlRoom) + '/state/m.room.name',
    null, { name: 'Telegram Agent' });
  const voteType = 'org.matrix.msc3381.poll.response';
  const vote = await reader.encryptEvent(controlRoom, voteType, {
    'm.relates_to': {rel_type:'m.reference',event_id:review.event},
    [voteType]: {answers:[approve]},
  });
  const voteId = await reader.put(controlRoom, 'fixture-approval-vote', vote);
  await waitFor(() => store.draft(draft).state === 'matrix_accepted', 'the encrypted vote to approve the isolated send');
  assert.equal(JSON.parse(store.draft(draft).approval).event, voteId);
  assert.equal(store.get('SELECT closed FROM draft_review WHERE event=?', review.event).closed, 1);
  console.log('Both review options arrived encrypted, and a single encrypted approval closed the poll and sent only into the disposable Matrix portal.');

  const setupDevice = 'TELEGRAM_SETUP';
  const setup = await api('/login', {type:'m.login.password', identifier:{type:'m.id.user',user:'telegram-agent'},
    password:'fixture-long-password', device_id:setupDevice});
  const setupCrypto = await connect({...setup, device:setupDevice}, 'setup-guide');
  const setupInitial = await setupCrypto.sync(null,0);
  await setupCrypto.applySync(setupInitial, async () => {});
  const setupSdk = new matrix.MatrixClient(url, setup.access_token);
  const setupClient = {getRoomState: room => setupSdk.getRoomState(room), doRequest: (...args) => setupSdk.doRequest(...args),
    crypto: {encryptRoomEvent: async (room, type, content) => JSON.parse(await setupCrypto.encryptEvent(room, type, content))}};
  const officeOptions = {client:setupClient, control:controlRoom, owner:b.user_id, guide:agent.user_id, domain:'telegram.test', bridgeControl:true};
  const officeInput = {id:'$office-fixture', action:'draft', target:'pilot', type:'direct', text:'Exact text from Office.\nSecond line.'};
  const queuedOffice = await telegramOfficeAction(officeInput, officeOptions);
  assert.equal(queuedOffice.ok, true);
  assert.deepEqual(await telegramOfficeAction(officeInput, officeOptions), queuedOffice);
  const officeEvent = decodeURIComponent(queuedOffice.message.split('/').at(-1));
  await waitFor(() => store.get('SELECT 1 FROM draft WHERE control_event=?', officeEvent), 'the Office draft');
  const fromOffice = store.get('SELECT * FROM draft WHERE control_event=?', officeEvent);
  assert.equal(fromOffice.body, officeInput.text);
  assert.equal(fromOffice.state, 'awaiting_approval');
  assert.equal(store.controlRequiresDot(officeEvent), false);
  assert.equal(store.get('SELECT count(*) AS n FROM draft WHERE control_event=?', officeEvent).n, 1);
  await castVote(reader, fromOffice, 'reject', 'fixture-owner-reject-office-draft');
  await waitFor(() => store.draft(fromOffice.id).state === 'cancelled', 'the operator decision on the Office draft');
  const syncedOwner = await reader.sync(controlCursor, 0);
  controlCursor = syncedOwner.next_batch;
  await reader.applySync(syncedOwner, async () => {});
  const authInput = await reader.encrypted(controlRoom, '!tg login qr');
  const authEvent = await reader.put(controlRoom, 'fixture-auth', authInput);
  const beforeAuth = store.setting('last_sync');
  await waitFor(() => store.setting('last_sync') > beforeAuth, 'a sync after the bridge authentication command');
  assert.equal(store.get('SELECT * FROM control_request WHERE event=?', authEvent), undefined);
  setupCrypto.close();
  console.log('The Guide device encrypted one Office request into Control across retries, preserving the exact text for operator review.');

  const handoff = { id: '$new-office', room: officeRoom, sender: dot.user_id, actor: '@task-manager:telegram.test' };
  const officeMessage = { target: 'Pilot', type: 'direct', text: 'Synthetic Office draft.\nExact second line.' };
  const submitOffice = () => requestTelegramService(sockets.TELEGRAM_HANDOFF_SOCKET, { ...handoff, method: 'submit', telegram: officeMessage });
  assert.equal((await submitOffice()).status, 'pending');
  assert.equal((await submitOffice()).status, 'pending');
  let delegated;
  await waitFor(async () => {
    delegated = await requestTelegramService(sockets.TELEGRAM_HANDOFF_SOCKET, { ...handoff, method: 'status' });
    return delegated.status === 'awaiting_approval';
  }, 'Task Manager to receive a private Telegram approval link');
  assert.deepEqual(Object.keys(delegated).sort(), ['link', 'status']);
  const delegatedEvent = decodeURIComponent(delegated.link.split('/').at(-1));
  const proposed = store.get('SELECT * FROM draft WHERE control_event=?', handoff.id);
  assert.equal(proposed.body, officeMessage.text);
  assert.equal(store.get('SELECT event FROM draft_review WHERE draft=?', proposed.id).event, delegatedEvent);
  assert.equal(store.get('SELECT thread FROM telegram_task WHERE id=?', handoff.id).thread, null);
  await waitFor(async () => {
    const sync = await reader.sync(controlCursor, 0);
    controlCursor = sync.next_batch;
    let poll;
    await reader.applySync(sync, async (roomId, event, encrypted, failed) => {
      if (roomId === controlRoom && event.event_id === delegatedEvent && encrypted && !failed) poll = event;
    });
    if (!poll) return false;
    assert.equal(poll.type, pollStart);
    assert.equal(poll.content['m.relates_to'], undefined);
    assert.deepEqual(poll.content['m.mentions'].user_ids, [b.user_id]);
    const question = poll.content[pollStart].question['org.matrix.msc1767.text'];
    assert.match(question, /pilot \(private chat\)/iu);
    assert.equal(question.split('\n\n').slice(1).join('\n\n'), officeMessage.text);
    return true;
  }, 'the exact Office draft in a top-level encrypted poll');
  await castVote(reader, proposed, 'reject', 'fixture-reject-natural-office');
  await waitFor(async () => (await requestTelegramService(sockets.TELEGRAM_HANDOFF_SOCKET, {
    ...handoff, method: 'status',
  })).status === 'declined', 'the operator rejection to reach Office');
  assert.equal(store.draft(proposed.id).event, null);
  assert.equal(store.get('SELECT decision FROM draft_review WHERE event=?', delegatedEvent).decision, 'reject');
  assert.equal(delegatedCalls, 1);

  const direct = await reader.encryptEvent(controlRoom, 'm.room.message', {
    msgtype: 'm.text', body: '@Telegram Agent: Invia una sola volta il testo esatto «ciao bello» alla chat privata di Pilot.',
    'm.mentions': { user_ids: [agent.user_id] },
  });
  const directEvent = await reader.put(controlRoom, 'fixture-mention-telegram-agent', direct);
  await waitFor(() => store.get('SELECT 1 FROM draft WHERE control_event=?', directEvent), 'the direct Telegram Agent mention draft');
  assert.equal(store.controlRequiresDot(directEvent), false);
  assert.equal(delegatedCalls, 2);
  const directDraft = store.get('SELECT * FROM draft WHERE control_event=?', directEvent);
  assert.equal(directDraft.body, 'ciao bello');
  assert.equal(directDraft.state, 'awaiting_approval');
  assert.equal(directDraft.event, null);
  await castVote(reader, directDraft, 'reject', 'fixture-reject-telegram-agent');
  await waitFor(() => store.draft(directDraft.id).state === 'cancelled', 'the direct draft to be rejected');
  console.log('A Dot request relayed by Task Manager and a direct Telegram Agent mention each produced an encrypted approval poll through a scoped ACP MCP turn.');

  const dotRequest = { id:'fixture-dot-compose', action:'compose', destination:'pilot', chat_type:'direct',
    text:'Exact test text from Dot' };
  const dotRooms = await fetch(url + root + '/joined_rooms', { headers:{authorization:'Bearer ' + dot.access_token} });
  assert.ok(!(await dotRooms.json()).joined_rooms.includes(controlRoom));
  const submitted = await requestTelegramService(sockets.TELEGRAM_DOT_SOCKET, dotRequest);
  assert.equal(submitted.status, 'queued');
  assert.deepEqual(await requestTelegramService(sockets.TELEGRAM_DOT_SOCKET, dotRequest), submitted);
  assert.equal((await requestTelegramService(sockets.TELEGRAM_DOT_SOCKET, { ...dotRequest, text: 'Changed' })).status, 'conflict');
  const request = submitted.event;
  await waitFor(() => store.get('SELECT 1 FROM draft WHERE control_event=?', request), 'the Dot draft');
  const fromDot = store.get('SELECT * FROM draft WHERE control_event=?', request);
  assert.equal(fromDot.state, 'awaiting_approval');
  assert.equal(fromDot.recipient, 'pilot (private chat)');
  assert.equal(fromDot.body, 'Exact test text from Dot');
  await waitFor(() => store.get('SELECT event FROM draft_review WHERE draft=?', fromDot.id), 'the Dot draft poll');
  await assert.rejects(() => api('/rooms/' + encodeURIComponent(controlRoom) + '/join', {}, dot.access_token), /M_FORBIDDEN/);
  assert.equal(store.draft(fromDot.id).state, 'awaiting_approval');
  assert.equal(store.get('SELECT count(*) AS n FROM draft WHERE control_event=?', request).n, 1);
  await castVote(reader, fromDot, 'reject', 'fixture-owner-reject-dot-draft');
  await waitFor(() => store.draft(fromDot.id).state === 'cancelled', 'the operator decision');
  console.log('The local Dot socket produced one exact draft with no access to Telegram Bridge.');

  const update = await reader.encryptEvent(controlRoom, 'm.room.message', {
    msgtype:'m.text', body:'@telegram-agent, mi dai un aggiornamento per oggi sul privato pilot?',
    'm.mentions': {user_ids:[agent.user_id]},
  });
  const updateId = await reader.put(controlRoom, 'fixture-owner-summary', update);
  await waitFor(() => store.get('SELECT status FROM control_request WHERE event=?', updateId)?.status === 'done',
    'the linked summary in Control');
  assert.equal(prompt.question, 'mi dai un aggiornamento per oggi sul privato pilot?');
  assert.deepEqual(prompt.messages.map(message => message.body), ['A synthetic Telegram draft.']);
  await waitFor(async () => {
    const sync = await reader.sync(controlCursor, 0);
    controlCursor = sync.next_batch;
    let found = false;
    await reader.applySync(sync, async (roomId, event, encrypted, failed) => {
      if (roomId !== controlRoom || event.content?.['m.relates_to']?.event_id !== updateId || !encrypted || failed) return;
      assert.deepEqual(event.content['m.mentions'].user_ids, [b.user_id]);
      assert.match(event.content.body, /Leggo una risposta di prova/);
      assert.ok(event.content.body.includes(encodeURIComponent(portal)));
      found = true;
    });
    return found;
  }, 'a private threaded update with an operator mention and a real source link');
  console.log('An owner update read the selected encrypted portal and returned a referenced reply with a Matrix mention.');

  const replyInThread = { rel_type:'m.thread', event_id:updateId, is_falling_back:true, 'm.in_reply_to':{event_id:updateId} };
  async function ownerFollowup(transaction, body) {
    const message = await reader.encryptEvent(controlRoom, 'm.room.message', {
      msgtype:'m.text', body, 'm.mentions':{ user_ids:[agent.user_id] }, 'm.relates_to':replyInThread,
    });
    return reader.put(controlRoom, transaction, message);
  }
  const followup = await ownerFollowup('fixture-thread-update', '@telegram-agent: Cosa ha detto prima?');
  await waitFor(() => store.get('SELECT status FROM control_request WHERE event=?', followup)?.status === 'done', 'the same-thread update');
  assert.equal(prompt.question, 'Cosa ha detto prima?');
  assert.deepEqual(prompt.messages.map(message => message.body), ['A synthetic Telegram draft.']);
  await waitFor(async () => {
    const sync = await reader.sync(controlCursor, 0);
    controlCursor = sync.next_batch;
    let found = false;
    await reader.applySync(sync, async (roomId, event, encrypted, failed) => {
      const relation = event.content?.['m.relates_to'];
      if (roomId !== controlRoom || relation?.['m.in_reply_to']?.event_id !== followup || !encrypted || failed) return;
      assert.equal(relation.event_id, updateId);
      found = true;
    });
    return found;
  }, 'an answer under the original root instead of a nested thread');

  const latestCipher = await remoteClient.encrypted(portal, 'Latest incoming fixture.');
  const latest = await remoteClient.put(portal, 'fixture-telegram-incoming', latestCipher);
  const mapping = new pg.Pool({ connectionString:auditDatabase });
  await mapping.query('INSERT INTO telegram_audit_message VALUES ($1,$2,$3,$4,$5,$6,$7)',
    [portal, 'user:1001', '2002', latest, '67890', remote.user_id, Date.now()]);
  await mapping.end();
  await waitFor(() => store.get('SELECT 1 FROM inbound WHERE room=? AND event=?', portal, latest), 'the verified inbound message');
  assert.ok(store.binding('pilot').active);
  const sendRequest = await ownerFollowup('fixture-thread-reply', '@telegram-agent: rispondi');
  await waitFor(() => store.get('SELECT 1 FROM draft WHERE control_event=?', sendRequest), 'the thread reply draft');
  assert.equal(draftPrompt.at(-1).body, 'Latest incoming fixture.');
  const threadDraft = store.get('SELECT * FROM draft WHERE control_event=?', sendRequest);
  assert.equal(threadDraft.body, 'Risposta esatta di prova.');
  assert.equal(threadDraft.reply_event, latest);
  assert.equal(threadDraft.state, 'awaiting_approval');
  assert.equal(threadDraft.event, null);
  await waitFor(() => store.get('SELECT event FROM draft_review WHERE draft=?', threadDraft.id), 'the review poll in the original thread');
  const threadReview = store.get('SELECT event FROM draft_review WHERE draft=?', threadDraft.id).event;
  await waitFor(async () => {
    const sync = await reader.sync(controlCursor, 0);
    controlCursor = sync.next_batch;
    let found = false;
    await reader.applySync(sync, async (roomId, event, encrypted, failed) => {
      if (roomId !== controlRoom || event.event_id !== threadReview || !encrypted || failed) return;
      assert.equal(event.type, pollStart);
      assert.equal(event.content['m.relates_to'].event_id, updateId);
      assert.equal(event.content['m.relates_to']['m.in_reply_to'].event_id, sendRequest);
      found = true;
    });
    return found;
  }, 'the operator to decrypt the approval poll inside the same thread');
  const repeat = await ownerFollowup('fixture-thread-repeat', '@telegram-agent: rispondi');
  await waitFor(() => store.get('SELECT status FROM control_request WHERE event=?', repeat)?.status === 'done', 'the duplicate draft notice');
  assert.equal(store.get('SELECT count(*) AS count FROM draft WHERE operator_approval=1 AND reply_event=?', latest).count, 1);
  console.log('A threaded follow-up reused the portal, and “rispondi” prepared one unsent reply for approval.');

  const starting = await reader.sync(controlCursor, 0);
  await reader.applySync(starting, async () => {});
  let cursor = starting.next_batch;
  const officeAssignment = await reader.encryptEvent(officeRoom, 'm.room.message', {
    msgtype: 'm.text', body: '@Telegram Agent, list my Telegram rooms', 'm.mentions': { user_ids: [agent.user_id] },
  });
  const officeEventId = await reader.put(officeRoom, 'fixture-direct-office', officeAssignment);
  await waitFor(() => store.get('SELECT status FROM telegram_office_receipt WHERE id=?', officeEventId)?.status === 'completed',
    'Telegram Agent to complete its own Office assignment');
  const privateReceipts = new Set();
  await waitFor(async () => {
    const next = await reader.sync(cursor, 0);
    cursor = next.next_batch;
    await reader.applySync(next, async (roomId, event, encrypted, failed) => {
      if (roomId !== officeRoom || event.sender !== agent.user_id || event.content?.['m.relates_to']?.event_id !== officeEventId ||
          event.type !== 'm.room.message' || !encrypted || failed) return;
      assert.doesNotMatch(event.content.body, /Pilot|1001/u);
      assert.ok(event.content.body.includes(encodeURIComponent(controlRoom)));
      privateReceipts.add(event.event_id);
    });
    return privateReceipts.size === 2;
  }, 'the operator to decrypt both status receipts in the original Office thread');
  console.log('Telegram Agent accepted a direct Office mention and returned only encrypted status receipts with a private link.');

  const officeSend = await reader.put(officeRoom, 'fixture-office-decline', await reader.encryptEvent(officeRoom, 'm.room.message', {
    msgtype: 'm.text', body: '@Telegram Agent, manda messaggio a Pilot «Draft for decline»',
    'm.mentions': { user_ids: [agent.user_id] },
  }));
  let declining;
  await waitFor(() => declining = store.get('SELECT * FROM draft WHERE control_event=?', officeSend), 'the Office send draft');
  await castVote(reader, declining, 'reject', 'fixture-office-decline-vote');
  await waitFor(() => store.get('SELECT status FROM telegram_office_receipt WHERE id=?', officeSend)?.status === 'declined',
    'the Office decline receipt');
  await waitFor(async () => {
    const next = await reader.sync(cursor, 0);
    cursor = next.next_batch;
    let declined = false;
    await reader.applySync(next, async (roomId, event, encrypted, failed) => {
      if (roomId !== officeRoom || event.sender !== agent.user_id || !encrypted || failed ||
          event.content?.['m.relates_to']?.event_id !== officeSend) return;
      if (typeof event.content.body === 'string' && event.content.body.includes('The operator declined the Telegram request')) {
        assert.doesNotMatch(event.content.body, /Pilot|Draft for decline/u);
        declined = true;
      }
    });
    return declined;
  }, 'an encrypted decline notice in the originating Office thread');
  assert.equal(store.draft(declining.id).event, null);
  console.log('Decline returned to the original encrypted Office thread without posting into the Telegram portal.');

  store.delivery(portal, store.draft(draft).event, 'SUCCESS', Date.now());
  const approvedOffice = { ...handoff, id: '$office-accept' };
  const sendOffice = method => requestTelegramService(sockets.TELEGRAM_HANDOFF_SOCKET, {
    ...approvedOffice, method, ...(method === 'submit' && { telegram: officeMessage }),
  });
  assert.equal((await sendOffice('submit')).status, 'pending');
  await waitFor(async () => (await sendOffice('status')).status === 'awaiting_approval', 'the Office poll to open');
  const approved = store.get('SELECT * FROM draft WHERE control_event=?', approvedOffice.id);
  await castVote(reader, approved, 'approve', 'fixture-office-accept-vote');
  await waitFor(() => store.draft(approved.id).state === 'matrix_accepted', 'the approved Office message in its bound portal');
  const sent = store.draft(approved.id);
  assert.equal(sent.room, portal);
  assert.equal(sent.attempts, 1);
  assert.equal(sent.body, officeMessage.text);
  store.delivery(portal, sent.event, 'SUCCESS', Date.now());
  await waitFor(async () => (await sendOffice('status')).status === 'completed', 'the confirmed delivery receipt for Office');
  console.log('Accept sent the exact approved draft once to its verified portal and returned completion to Office.');

  await spaceClient.doRequest('PUT', childRoute, null, {});
  const removed = await reader.put(controlRoom, 'fixture-removed-room-draft',
    await reader.encrypted(controlRoom, 'telegram draft direct "pilot": This room was removed.'));
  await waitFor(() => store.get('SELECT status FROM control_request WHERE event=?', removed)?.status === 'done',
    'the removed room to refuse a new draft');
  assert.equal(store.get('SELECT 1 FROM draft WHERE control_event=?', removed), undefined);
  await spaceClient.doRequest('PUT', childRoute, null, {via:['telegram.test']});
  console.log('Unlinking the verified Telegram room prevented it from receiving a new Control draft.');

  await api(portalRoute + '/leave', {}, agent.access_token);
  await waitFor(() => store.binding('pilot').active === 0, 'the binding to pause after leaving');
  assert.equal(store.setting('pause_reason:pilot'), 'portal_membership_lost');
  console.log('Initial portal sync completed before activation, and later membership loss still paused the binding.');
} finally {
  binder?.kill('SIGTERM');
  worker.kill('SIGCONT');
  worker.kill('SIGTERM');
  await workerExit;
  store.db.close();
  reader.close();
  remoteClient.close();
  guide.close();
  acp.close();
  https.close();
}
