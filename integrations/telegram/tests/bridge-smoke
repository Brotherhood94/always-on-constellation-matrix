chmod 0644 "$fixture/key.pem"
docker network create --internal "$network" >/dev/null
docker volume create "$state" >/dev/null
docker run --rm --network none -v "$state:/state" --entrypoint sh "$py" -c 'umask 077; mkdir /state/bridge /state/synapse /state/guide; chown 991:991 /state/bridge; echo "{\"api_id\":42,\"api_hash\":\"0123456789abcdef0123456789abcdef\"}" >/state/dummy.json'
