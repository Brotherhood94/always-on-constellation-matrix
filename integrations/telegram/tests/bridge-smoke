  -g -c /state/bridge/config.yaml -r /state/bridge/registration.yaml

bridge_config_json() {
  docker run --rm --network none -v "$state:/state:ro" --entrypoint yq "$images" -o=json . /state/bridge/config.yaml
}

update_portal() {
  bridge_config_json |
    docker run --rm -i --network none -v "$state:/state" -v "$src:/src:ro" --entrypoint python3 "$py" \
      -B /src/bridge_config.py "$1" /state user:1001 2002
}

config_before=$(bridge_config_json | shasum -a 256)
update_portal allow
update_portal allow
bridge_config_json | python3 -c 'import json, sys; assert json.load(sys.stdin)["bridge"]["portal_create_filter"]["list"] == [{"id": "user:1001", "receiver": "2002"}]'
