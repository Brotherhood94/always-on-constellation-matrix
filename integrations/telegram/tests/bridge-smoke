  docker run --rm -i --network none --entrypoint yq "$images" -o=json . - |
  docker run --rm -i --network none -v "$state:/state" -v "$src:/src:ro" -e MATRIX_SERVER_NAME=telegram.test -e MATRIX_OWNER=@operator:telegram.test \
    --entrypoint python3 "$py" -B /src/bridge_config.py generate /state /state/dummy.json
