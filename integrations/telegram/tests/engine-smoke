#!/usr/bin/env bash
set -Eeuo pipefail
base=tgengine-$$
net=$base-net
instance=$base-instance
exchange=$base-exchange
engine=$base-engine
image=${TELEGRAM_ENGINE_TEST_IMAGE:-matrix-telegram-engine:0.1.2}
connector=matrix-telegram-connector:0.2.1
provider_env=()
if [[ ${1:-} == --shared-provider ]]; then
  provider_env=(-e HIRING_PROVIDER_MODE=chatgpt_codex -e AGENT_USERNAME=telegram-agent
                -e AGENT_REASONING=low -e HIRING_GRANT_ID=fixture-grant)
fi
cleanup() {
  docker rm -f "$engine" >/dev/null 2>&1 || true
  docker network rm "$net" >/dev/null 2>&1 || true
  docker volume rm "$instance" "$exchange" >/dev/null 2>&1 || true
}
trap cleanup EXIT
docker network create --internal "$net" >/dev/null
docker volume create "$instance" >/dev/null
docker volume create "$exchange" >/dev/null
docker run --rm --network none --user 0:0 -v "$instance:/instance" -v "$exchange:/exchange" \
  --entrypoint /bin/sh "$image" -c 'chown 991:991 /instance /exchange'
docker run -d --name "$engine" --network "$net" --network-alias telegram-engine --read-only --tmpfs /tmp \
  -e TELEGRAM_MODEL=gpt-6.2-sol "${provider_env[@]}" -v "$instance:/instance" -v "$exchange:/exchange" \
  -v "$exchange:/telegram-mcp" "$image" >/dev/null
ready=false
for _ in {1..25}; do
  if docker exec "$engine" curl -fsS --cacert /exchange/ca.pem https://telegram-engine:19443/ >/dev/null 2>&1; then
    ready=true
    break
  fi
  sleep 1
done
if [[ $ready != true ]]; then
  docker logs "$engine" --tail 20
  exit 1
fi
docker exec -i "$engine" /opt/amplifier-acp/.venv/bin/python -B - <<'PY'
import asyncio
import json
import os
from pathlib import Path
from shutil import copytree

from amplifier_acp.native.host.config import load_config
from amplifier_acp.native.host.session import load_root_bundle
import yaml

acp = json.loads(Path('/instance/backend/agent.json').read_text())
config = load_config('/instance/workspace', home=acp['appHome'], legacy_home=acp['home'])
_, loaded, _ = asyncio.run(load_root_bundle(config, acp['bundle']))
assert not loaded.hooks, [row['module'] for row in loaded.hooks]
assert not loaded.tools and not loaded.agents
if os.environ.get('HIRING_PROVIDER_MODE'):
    assert [row['module'] for row in loaded.providers] == ['provider-constellation-hiring']
    assert loaded.providers[0]['config']['mode'] == 'chatgpt_codex'
    instance = json.loads(Path('/instance/config.json').read_text())
    assert instance['config']['backend']['env'] == {
        'AGENT_USERNAME': 'telegram-agent', 'HIRING_GRANT_ID': 'fixture-grant',
    }
else:
    assert [row['module'] for row in loaded.providers] == ['provider-openai-chatgpt']
    assert loaded.providers[0]['config']['auth_mode'] == 'chatgpt_codex'
assert acp['runtimeImmutable'] is True

# Use the deployed plan and replace only its provider for offline inference.
bundle = Path(acp['bundle'])
document = yaml.safe_load(bundle.read_text())
fixture = copytree(Path('/opt/amplifier-acp/tests/fixtures/provider'), Path('/instance/test-provider'))
provider = fixture / 'amplifier_module_provider_fixture' / '__init__.py'
source = provider.read_text()
marker = "        if self.config.get('inputOutcomeFailure') and 'fail-outcome' in str(prompt):"
assert marker in source
provider.write_text(source.replace(marker, '''        if 'telegram_list_rooms' in str(prompt) and request.messages[-1].role != 'tool':
            names = [tool.name for tool in request.tools]
            name = next(name for name in names if name.endswith('telegram_list_rooms'))
            return ChatResponse(content=[TextBlock(text='Calling the Telegram tool.')], tool_calls=[ToolCall(id='telegram-call', name=name, arguments={})], finish_reason='tool_calls')
''' + marker))
document['providers'] = [{'module': 'provider-fixture', 'source': str(fixture)}]
bundle.write_text(yaml.safe_dump(document))
credential = json.loads(Path('/exchange/credential.json').read_text())
Path('/exchange/fixture-token').write_text(credential['token'])
PY
docker exec -d "$engine" /usr/local/bin/node -e '
  const { createServer } = require("node:http");
  const { writeFileSync } = require("node:fs");
  createServer(async (req, res) => {
    const chunks = [];
    for await (const chunk of req) chunks.push(chunk);
    writeFileSync("/exchange/mcp-request", Buffer.concat(chunks));
    res.end(JSON.stringify({ status: "completed" }));
  }).listen("/telegram-mcp/tools.sock");'
docker run --rm -i --network "$net" -v "$exchange:/exchange:ro" --entrypoint node "$connector" --input-type=module - <<'JS'
import assert from 'node:assert/strict';
import { readFile } from 'node:fs/promises';
import { draftWithInstance, runDelegatedWithInstance } from './acp.mjs';
const engine = { url:'wss://telegram-engine:19443/api/v1/acp', token:'/exchange/fixture-token', ca:'/exchange/ca.pem', revision:'fixture', workspace:'/instance/workspace' };
let id;
const result = await draftWithInstance(engine, null, [{author:'remote',body:'Offline first draft test'}], value => { id = value; });
assert.ok(id);
assert.match(result, /Offline first draft test/);
const reloaded = await draftWithInstance(engine, id, [{author:'remote',body:'Offline second draft test'}], value => { assert.equal(value, id); });
assert.match(reloaded, /Offline second draft test/);
const token = 'a'.repeat(64);
await runDelegatedWithInstance(engine, token, 'list_rooms');
assert.deepEqual(JSON.parse(await readFile('/exchange/mcp-request', 'utf8')), { grant: token, tool: 'list_rooms' });
console.log('Real Instance and Amplifier ACP restored a session and called the scoped Telegram stdio MCP tool with the offline provider.');
JS
