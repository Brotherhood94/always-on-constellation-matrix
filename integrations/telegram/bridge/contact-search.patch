+const userSearchLimit = 10
+
+func matchingSavedContacts(users []tg.UserClass, query string) []tg.UserClass {
+	query = strings.ToLower(strings.Join(strings.Fields(query), " "))
+	usernameOnly := strings.HasPrefix(query, "@")
+	query = strings.TrimPrefix(query, "@")
+	if query == "" {
+		return nil
+	}
+	var matches []tg.UserClass
+	for _, candidate := range users {
+		user, ok := candidate.(*tg.User)
+		if !ok || user.Deleted {
+			continue
+		}
+		name := strings.ToLower(strings.Join(strings.Fields(user.FirstName+" "+user.LastName), " "))
+		if (!usernameOnly && strings.Contains(name, query)) || strings.Contains(strings.ToLower(user.Username), query) {
+			matches = append(matches, user)
+			if len(matches) == userSearchLimit {
+				break
+			}
+		}
+	}
+	return matches
+}
