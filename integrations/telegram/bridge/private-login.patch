+// The setup wizard reaches this API using docker exec inside the bridge.
+func constellationLocalLogin(r *http.Request, path string) bool {
+	if r.Method != http.MethodPost {
+		return false
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	if err != nil || !net.ParseIP(host).IsLoopback() {
+		return false
+	}
+	return path == "/v3/login/start/qr" || strings.HasPrefix(path, "/v3/login/cancel/") ||
+		strings.HasPrefix(path, "/v3/login/step/") &&
+			(strings.HasSuffix(path, "/display_and_wait") || strings.HasSuffix(path, "/user_input"))
+}
