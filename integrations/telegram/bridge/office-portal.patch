+func (prov *ProvisioningAPI) PostConstellationGroupAction(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	user := prov.GetUser(r)
+	if !user.Permissions.Admin {
+		mautrix.MForbidden.Write(w)
+		return
+	}
+	var req struct {
+		Room id.RoomID `json:"room"`
+		Peer string `json:"peer"`
+		Name string `json:"name"`
+		Members []string `json:"members"`
+		Since int64 `json:"since"`
+		Before int64 `json:"before"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 8192)
+	if json.NewDecoder(r.Body).Decode(&req) != nil {
+		mautrix.MNotJSON.Write(w)
+		return
+	}
+	action := r.PathValue("action")
+	if action == "sync-groups" {
+		login := prov.GetLoginForRequest(w, r)
+		if login == nil {
+			return
+		}
+		if login.Client == nil || !login.Client.IsLoggedIn() {
+			ErrNotLoggedIn.Write(w)
+			return
+		}
+		client, ok := login.Client.(interface{ ConstellationSyncGroups(context.Context) error })
+		if !ok {
+			mautrix.MUnrecognized.Write(w)
+			return
+		}
+		if err := client.ConstellationSyncGroups(ctx); err != nil {
+			RespondWithError(w, err, "Could not refresh Telegram group discovery")
+			return
+		}
+		exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"ok": true})
+		return
+	}
+	members := make([]networkid.UserID, 0, len(req.Members))
+	if action == "create-group" || action == "add-members" {
+		if len(req.Members) == 0 || len(req.Members) > 20 {
+			mautrix.MInvalidParam.Write(w)
+			return
+		}
+		for _, member := range req.Members {
+			if !provisionutil.IsTelegramUserID(member) {
+				mautrix.MInvalidParam.Write(w)
+				return
+			}
+			members = append(members, networkid.UserID(strings.TrimPrefix(member, "user:")))
+		}
+	}
+	if action == "create-group" {
+		login := prov.GetLoginForRequest(w, r)
+		if login == nil {
+			return
+		}
+		if strings.TrimSpace(req.Name) == "" || len(req.Name) > 120 {
+			mautrix.MInvalidParam.Write(w)
+			return
+		}
+		group, err := provisionutil.CreateGroup(ctx, login, &bridgev2.GroupCreateParams{
+			Type: "group", Name: &event.RoomNameEventContent{Name: req.Name}, Participants: members,
+		})
+		if err != nil {
+			RespondWithError(w, err, "Telegram did not confirm the group creation")
+			return
+		}
+		results := make([]map[string]string, 0, len(req.Members))
+		for _, member := range req.Members {
+			status := "added"
+			if group.FailedParticipants[networkid.UserID(strings.TrimPrefix(member, "user:"))] != nil {
+				status = "not_added"
+			}
+			results = append(results, map[string]string{"peer": member, "status": status})
+		}
+		exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": group.MXID, "peer": group.ID, "members": results})
+		return
+	}
+	portal, err := prov.br.Bridge.GetPortalByMXID(ctx, req.Room)
+	if err != nil {
+		RespondWithError(w, err, "Could not verify the Telegram portal")
+		return
+	}
+	if portal == nil || portal.UserBlocked || portal.MessageRequest || portal.ParentKey.ID != "" ||
+		string(portal.ID) != req.Peer || !provisionutil.IsTelegramUserID(req.Peer) && !provisionutil.IsTelegramGroupID(req.Peer) {
+		mautrix.MForbidden.Write(w)
+		return
+	}
+	login := prov.br.Bridge.GetCachedUserLoginByID(portal.Receiver)
+	if login == nil || login.UserMXID != user.MXID || login.Client == nil || !login.Client.IsLoggedIn() {
+		ErrNotLoggedIn.Write(w)
+		return
+	}
+	verified, err := provisionutil.ResolveTelegramPortal(ctx, login, req.Peer, false)
+	if err != nil || verified == nil || verified.MXID != req.Room {
+		mautrix.MForbidden.WithMessage("This Telegram portal is not eligible").Write(w)
+		return
+	}
+	if action == "add-members" && provisionutil.IsTelegramGroupID(req.Peer) {
+		client, ok := login.Client.(interface {
+			ConstellationInvite(context.Context, networkid.PortalID, []string) ([]map[string]string, error)
+		})
+		if !ok {
+			mautrix.MUnrecognized.Write(w)
+			return
+		}
+		results, err := client.ConstellationInvite(ctx, portal.ID, req.Members)
+		if err != nil {
+			RespondWithError(w, err, "Telegram did not confirm the invitations")
+			return
+		}
+		exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": req.Room, "peer": req.Peer, "members": results})
+		return
+	}
+	if action == "history" && req.Since > 0 && req.Before > req.Since {
+		client, ok := login.Client.(interface {
+			ConstellationHistory(context.Context, networkid.PortalID, int64, int64) ([]map[string]any, bool, error)
+		})
+		if !ok {
+			mautrix.MUnrecognized.Write(w)
+			return
+		}
+		messages, complete, err := client.ConstellationHistory(ctx, portal.ID, req.Since, req.Before)
+		if err != nil {
+			RespondWithError(w, err, "Telegram history is unavailable")
+			return
+		}
+		exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": req.Room, "peer": req.Peer, "messages": messages, "complete": complete})
+		return
+	}
+	mautrix.MInvalidParam.Write(w)
+}
