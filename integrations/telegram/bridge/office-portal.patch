+// PostConstellationMembership invites only this deployment's Telegram Agent to
+// an existing split portal of the authenticated operator's logged-in account.
+func (prov *ProvisioningAPI) PostConstellationMembership(w http.ResponseWriter, r *http.Request) {
+	ctx := r.Context()
+	login := prov.GetLoginForRequest(w, r)
+	if login == nil {
+		return
+	}
+	portal, err := provisionutil.ResolveTelegramPortal(ctx, login, r.PathValue("peer"), false)
+	if err != nil {
+		RespondWithError(w, err, "Could not verify the Telegram portal")
+		return
+	}
+	if portal.MXID == "" || portal.MXID.String() != r.URL.Query().Get("room_id") {
+		mautrix.MForbidden.WithMessage("Telegram portal room changed").Write(w)
+		return
+	}
+	var create, rules, encryption map[string]any
+	bot := prov.br.Bot
+	if bot.StateEvent(ctx, portal.MXID, event.StateCreate, "", &create) != nil ||
+		bot.StateEvent(ctx, portal.MXID, event.StateJoinRules, "", &rules) != nil ||
+		bot.StateEvent(ctx, portal.MXID, event.StateEncryption, "", &encryption) != nil ||
+		create["m.federate"] != false || rules["join_rule"] != "invite" ||
+		encryption["algorithm"] != "m.megolm.v1.aes-sha2" {
+		mautrix.MForbidden.WithMessage("Telegram portal must be private, local and encrypted").Write(w)
+		return
+	}
+	members, err := portal.Bridge.Matrix.GetMembers(ctx, portal.MXID)
+	if err != nil {
+		RespondWithError(w, err, "Could not verify portal membership")
+		return
+	}
+	agent := id.NewUserID("telegram-agent", portal.Bridge.Matrix.ServerName())
+	if owner := members[login.UserMXID]; owner == nil || owner.Membership != event.MembershipJoin {
+		mautrix.MForbidden.WithMessage("Join the verified Telegram portal before connecting Telegram Agent").Write(w)
+		return
+	}
+	for user, member := range members {
+		if member.Membership == event.MembershipJoin || member.Membership == event.MembershipInvite {
+			if user != login.UserMXID && user != agent && user != bot.UserID && !portal.Bridge.IsGhostMXID(user) {
+				mautrix.MForbidden.WithMessage("Telegram portal has an unexpected participant").Write(w)
+				return
+			}
+		}
+	}
+	if member := members[agent]; member != nil && member.Membership == event.MembershipBan {
+		mautrix.MForbidden.WithMessage("Telegram Agent was banned from this portal").Write(w)
+		return
+	} else if member == nil || (member.Membership != event.MembershipJoin && member.Membership != event.MembershipInvite) {
+		_, err = portal.Bridge.Bot.SendState(ctx, portal.MXID, event.StateMember, agent.String(), &event.Content{
+			Parsed: &event.MemberEventContent{Membership: event.MembershipInvite},
+		}, time.Time{})
+		if err != nil {
+			RespondWithError(w, err, "Could not invite Telegram Agent")
+			return
+		}
+	}
+	exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": portal.MXID})
+}
