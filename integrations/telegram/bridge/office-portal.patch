+func (prov *ProvisioningAPI) PostConstellationGroup(w http.ResponseWriter, r *http.Request) {
+	peer := r.PathValue("peer")
+	kind, value, _ := strings.Cut(peer, ":")
+	if number, err := strconv.ParseInt(value, 10, 64); err != nil || number <= 0 || (kind != "chat" && kind != "channel") {
+		mautrix.MNotFound.WithMessage("Use an existing Telegram group ID").Write(w)
+		return
+	}
+	login := prov.GetLoginForRequest(w, r)
+	if login == nil {
+		return
+	}
+	if !login.Client.IsLoggedIn() {
+		ErrNotLoggedIn.Write(w)
+		return
+	}
+	ctx := r.Context()
+	portal, err := prov.br.Bridge.GetExistingPortalByKey(ctx, networkid.PortalKey{ID: networkid.PortalID(peer), Receiver: login.ID})
+	if err != nil {
+		RespondWithError(w, err, "Could not read the Telegram group")
+		return
+	}
+	if portal == nil {
+		mautrix.MNotFound.WithMessage("Group not found. Run sync-chats in Telegram Bridge and retry").Write(w)
+		return
+	}
+	if portal.ParentKey.ID != "" || portal.UserBlocked || portal.MessageRequest {
+		mautrix.MForbidden.WithMessage("This Telegram group cannot be opened from Office").Write(w)
+		return
+	}
+	if kind == "channel" {
+		var flags struct {
+			Supergroup   bool `json:"is_supergroup"`
+			ForumGeneral bool `json:"is_forum_general"`
+		}
+		metadata, err := json.Marshal(portal.Metadata)
+		if err != nil || json.Unmarshal(metadata, &flags) != nil || !flags.Supergroup || flags.ForumGeneral {
+			mautrix.MForbidden.WithMessage("Only Telegram groups without topics can be opened from Office").Write(w)
+			return
+		}
+	}
+	if portal.MXID == "" {
+		info, err := login.Client.GetChatInfo(ctx, portal)
+		if err != nil {
+			RespondWithError(w, err, "Could not verify the Telegram group")
+			return
+		}
+		if info == nil {
+			mautrix.MNotFound.WithMessage("Telegram group information is unavailable").Write(w)
+			return
+		}
+		if err = portal.CreateMatrixRoom(ctx, login, info); err != nil {
+			RespondWithError(w, err, "Could not open the Telegram group")
+			return
+		}
+	}
+	exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": portal.MXID, "name": portal.Name})
+}
