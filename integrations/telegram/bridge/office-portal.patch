+
+func (prov *ProvisioningAPI) PostConstellationGroup(w http.ResponseWriter, r *http.Request) {
+	peer := r.PathValue("peer")
+	if !provisionutil.IsTelegramGroupID(peer) {
+		mautrix.MNotFound.WithMessage("Use an existing Telegram group ID").Write(w)
+		return
+	}
+	login := prov.GetLoginForRequest(w, r)
+	if login == nil {
+		return
+	}
+	if login.Client == nil || !login.Client.IsLoggedIn() {
+		ErrNotLoggedIn.Write(w)
+		return
+	}
+	portal, err := provisionutil.ResolveTelegramGroup(r.Context(), login, peer, true)
+	if err != nil {
+		RespondWithError(w, err, "Could not open the Telegram group")
+		return
+	}
+	exhttp.WriteJSONResponse(w, http.StatusOK, map[string]any{"room": portal.MXID, "name": portal.Name})
