+
+func formatResolvedTelegramTarget(name, id, prefix, target string) string {
+	label := "<code>" + html.EscapeString(id) + "</code>"
+	if name != "" {
+		label = "<strong>" + html.EscapeString(name) + "</strong> (" + label + ")"
+	}
+	command := prefix + " resolve-identifier --open " + target
+	return "Found " + label + ". To add the chat to Telegram → Rooms, send <code>" + html.EscapeString(command) + "</code>."
+}
+
+func formatResolvedRoomLink(name, identifier string, room id.RoomID, open bool) string {
+	link := formatOpenedChatLink(name, room, false)
+	if !open {
+		return link + " (<code>" + html.EscapeString(identifier) + "</code>)"
+	}
+	return link
+}
+
+func formatOpenedChatLink(name string, room id.RoomID, created bool) string {
+	if name == "" {
+		name = room.String()
+	}
+	action := "Open chat"
+	if created {
+		action = "Created chat"
+	}
+	return fmt.Sprintf(`%s: <a href="%s">%s</a>`, action, html.EscapeString(room.URI().MatrixToURL()), html.EscapeString(name))
