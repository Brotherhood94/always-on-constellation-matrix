#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
stack_dir=${TELEGRAM_STACK_DIR:-/opt/matrix-stack}
owner_override=${MATRIX_OWNER:-}
[[ $EUID == 0 && -f "$stack_dir/.env" ]] || { echo 'Run as root with the installed Matrix stack.' >&2; exit 1; }
set -a
. "$stack_dir/.env"
set +a
export TELEGRAM_DATA="$MATRIX_DATA/telegram"
image=dock.mau.dev/mautrix/telegram:v26.11@sha256:fe78dbce96dca82f077371f429776ab1fee3b65ddc83924a257279b142160945
stack=(docker compose --project-directory "$stack_dir")
compose=(docker compose -p "${TELEGRAM_PROJECT:-matrix-telegram}" -f "$dir/compose.yaml")
config=(python3 -B "$dir/bridge_config.py")
install -d -m 0711 "$TELEGRAM_DATA"
install -d -m 0700 -o 991 -g 991 "$TELEGRAM_DATA/office" "$TELEGRAM_DATA/guide-actions" \
  "$TELEGRAM_DATA/handoffs" "$TELEGRAM_DATA/mcp" "$TELEGRAM_DATA/dot-requests"
install -d -m 0700 -o 991 -g 991 "$TELEGRAM_DATA/guide-actions"
exec 9>"$TELEGRAM_DATA/operator.lock"
flock -n 9 || { echo 'Another Telegram operator command is running.' >&2; exit 1; }

resolve_matrix_owner() {
  local agents_config="${TELEGRAM_AGENTS_DIR:-/opt/matrix-agents}/.env"
  local owner=${owner_override:-${MATRIX_OWNER:-}}
  if [[ -z $owner && -r $agents_config ]]; then
    owner=$( . "$agents_config"; printf '%s' "${MATRIX_OWNER:-}" )
  fi
  if [[ ! ${owner%%:*} =~ ^@[a-z0-9._=/-]+$ || $owner != *:* || ${owner#*:} != "$MATRIX_SERVER_NAME" ]]; then
    echo 'Set MATRIX_OWNER to the full local Matrix operator ID.' >&2
    return 1
  fi
  export MATRIX_OWNER="$owner"
}

prepare_office_provisioning() {
  install -d -m 0700 -o 991 -g 991 "$TELEGRAM_DATA/guide"
  docker run --rm -i --network none --entrypoint yq "$image" -o=json '.' \
    < "$TELEGRAM_DATA/bridge/config.yaml" |
    "${config[@]}" office-provisioning "$TELEGRAM_DATA"
}

bridge_recreate=()
configure_office_bridge() {
  local configuration
  configuration=$(prepare_office_provisioning)
  if [[ $configuration == changed || ${1:-} == --refresh-bridge ]]; then bridge_recreate+=(--force-recreate); fi
}

case ${1:-} in
  setup-state)
    mode=${2:-agent}
    [[ $mode == agent || $mode == bridge ]]
    if [[ $mode == agent &&
          ( -e "$TELEGRAM_DATA/connector/relocation-drain" || -e "$TELEGRAM_DATA/engine-moved" ) ]]; then
      echo managed
      exit
    fi
    running=$("${compose[@]}" --profile agent ps --status running --services)
    if [[ $mode == agent && ( ! -s "$TELEGRAM_DATA/connector/config.json" ||
          ! -s "$TELEGRAM_DATA/connector/engine-token" || ! -s "$TELEGRAM_DATA/connector/engine-ca.pem" ) ]]; then
      echo engine
    elif [[ $mode == agent && ! -s "$TELEGRAM_DATA/connector/backend-verified" ]]; then
      if grep -Fxq telegram-engine <<< "$running"; then
        echo provider
      else
        echo engine
      fi
    elif [[ ! -s "$TELEGRAM_DATA/bridge/registration.yaml" ]]; then
      echo credentials
    elif ! grep -Fxq telegram-bridge <<< "$running" || [[ ! -s "$TELEGRAM_DATA/guide/space-db" ]]; then
      echo bridge
    else
      resolve_matrix_owner
      logged_in=$("${stack[@]}" exec -T postgres psql -AtqX --set ON_ERROR_STOP=1 \
        --set "owner=$MATRIX_OWNER" -U synapse -d matrix_telegram <<'SQL'
SELECT EXISTS (SELECT 1 FROM user_login WHERE user_mxid = :'owner');
SQL
      )
      if [[ $logged_in != t ]]; then
        echo login
      elif [[ $mode == bridge ]]; then
        echo ready
      elif ! grep -Fxq telegram-engine <<< "$running"; then
        echo engine
      elif ! grep -Fxq connector <<< "$running"; then
        echo start
      else
        echo ready
      fi
    fi
    ;;
  quiesce-layout)
    if [[ -n $("${compose[@]}" --profile agent ps --status running --quiet connector) ]]; then
      "${compose[@]}" --profile agent stop connector
      : > "$TELEGRAM_DATA/restart-connector"
    fi
    "${compose[@]}" stop telegram-guide
    ;;
  resume-layout)
    "${compose[@]}" start telegram-guide
    if [[ -f "$TELEGRAM_DATA/restart-connector" ]]; then
      "${compose[@]}" --profile agent start connector
      rm -- "$TELEGRAM_DATA/restart-connector"
    fi
    ;;
  start-guide)
    [[ ( $# == 1 || ( $# == 2 && $2 == --refresh-bridge ) ) &&
       -s "$TELEGRAM_DATA/guide/token" && -s "$TELEGRAM_DATA/guide/room-id" ]]
    if [[ -n $("${compose[@]}" ps --status running --quiet telegram-bridge) ]]; then
      configure_office_bridge "${2:-}"
      "${config[@]}" database-sql "$TELEGRAM_DATA" |
        "${stack[@]}" exec -T postgres psql -qX --set ON_ERROR_STOP=1 -U synapse -d postgres
      "${stack[@]}" exec -T postgres psql -qX --set ON_ERROR_STOP=1 -U synapse -d matrix_telegram < "$dir/space.sql"
      "${config[@]}" space-reader "$TELEGRAM_DATA"
      "${compose[@]}" up -d --no-deps --build --wait --wait-timeout 120 "${bridge_recreate[@]}" telegram-bridge
    fi
    "${compose[@]}" up -d --no-deps --build --force-recreate telegram-guide
    if [[ -f "$TELEGRAM_DATA/restart-connector" || -n $("${compose[@]}" --profile agent ps --status running --quiet connector) ]]; then
      if [[ ${2:-} == --refresh-bridge && ! -e "$TELEGRAM_DATA/engine-moved" &&
            ! -e "$TELEGRAM_DATA/connector/relocation-drain" ]]; then
        "${compose[@]}" --profile agent up -d --no-deps --build --wait --wait-timeout 120 telegram-engine
      fi
      "${compose[@]}" --profile agent up -d --no-deps --build --force-recreate connector
      rm -f -- "$TELEGRAM_DATA/restart-connector"
    fi
    ;;
  prepare)
    [[ $# == 2 ]] || { echo 'Use telegram prepare PRIVATE_API_CREDENTIALS_JSON' >&2; exit 2; }
    resolve_matrix_owner
    install -d -m 0700 -o 991 -g 991 "$TELEGRAM_DATA/bridge" "$TELEGRAM_DATA/connector"
    docker network inspect "${TELEGRAM_MATRIX_NETWORK:-matrix-stack_clients}" "${TELEGRAM_DATABASE_NETWORK:-matrix-stack_database}" >/dev/null
    if [[ ! -s "$TELEGRAM_DATA/bridge/config.yaml" ]]; then
      if ! docker image inspect "$image" >/dev/null 2>&1; then
        docker pull "$image"
      fi
      docker run --rm --network none --entrypoint /usr/bin/mautrix-telegram "$image" -e -c - |
        docker run --rm -i --network none --entrypoint yq "$image" -o=json '.' - |
        "${config[@]}" generate "$TELEGRAM_DATA" "$2"
    fi
    if [[ ! -s "$TELEGRAM_DATA/bridge/registration.yaml" ]]; then
      docker run --rm --network none --user 991:991 --volume "$TELEGRAM_DATA/bridge:/data" \
        --entrypoint /usr/bin/mautrix-telegram "$image" -g -c /data/config.yaml -r /data/registration.yaml
    fi
    "${config[@]}" database-sql "$TELEGRAM_DATA" |
      "${stack[@]}" exec -T postgres psql -qX --set ON_ERROR_STOP=1 -U synapse -d postgres
    echo 'Telegram bridge is prepared with an empty portal allowlist. Activation is separate.'
    ;;
  activate)
    [[ $# == 1 && -s "$TELEGRAM_DATA/bridge/registration.yaml" ]]
    configure_office_bridge
    "${compose[@]}" build telegram-bridge
    previous=$(mktemp "$TELEGRAM_DATA/.synapse-config.XXXXXXXX")
    cp -p "$MATRIX_DATA/synapse/homeserver.yaml" "$previous"
    "${config[@]}" enable "$TELEGRAM_DATA"
    if "${compose[@]}" up -d --no-deps "${bridge_recreate[@]}" telegram-bridge &&
       "${stack[@]}" restart synapse &&
       "${stack[@]}" up -d --no-deps --wait --wait-timeout 120 synapse &&
       "${compose[@]}" up -d --no-deps --wait --wait-timeout 120 telegram-bridge; then
      rm -f -- "$previous"
    else
      "${compose[@]}" stop telegram-bridge || true
      cp -p "$previous" "$MATRIX_DATA/synapse/homeserver.yaml"
      "${stack[@]}" restart synapse
      echo "Activation rolled back. The previous configuration is retained at $previous." >&2
      exit 1
    fi
    echo 'Telegram Bridge is ready for the operator login.'
    ;;
  allow|disallow)
    [[ $# == 3 ]] || { echo 'Use telegram allow|disallow PEER LOGIN_ID' >&2; exit 2; }
    docker run --rm -i --network none --entrypoint yq "$image" -o=json '.' - \
      < "$TELEGRAM_DATA/bridge/config.yaml" |
      "${config[@]}" "$1" "$TELEGRAM_DATA" "$2" "$3"
    if [[ -n $("${compose[@]}" ps --status running --quiet telegram-bridge) ]]; then
      "${compose[@]}" restart telegram-bridge
    fi
    ;;
  prepare-agent)
    [[ ! -e "$TELEGRAM_DATA/connector/relocation-drain" ]] || { echo 'Finish the pending Telegram Agent move first.' >&2; exit 1; }
    [[ ! -e "$TELEGRAM_DATA/engine-moved" ]] || { echo 'Move Telegram Agent back to the VPS before preparing a local engine.' >&2; exit 1; }
    [[ $# == 1 ]] || { echo 'Use telegram prepare-agent.' >&2; exit 2; }
    resolve_matrix_owner
    export TELEGRAM_MODEL=${TELEGRAM_MODEL:-gpt-6.2-sol}
    "${compose[@]}" --profile agent build connector telegram-engine
    rm -f -- "$TELEGRAM_DATA/connector/backend-verified"
    install -d -m 0700 -o 991 -g 991 "$TELEGRAM_DATA/instance" "$TELEGRAM_DATA/exchange"
    PYTHONPATH="${PYTHONPATH:-$stack_dir}:$dir" python3 -B "$dir/telegram_provision.py" bootstrap "$TELEGRAM_DATA"
    "${compose[@]}" --profile agent up -d --wait --wait-timeout 120 telegram-engine
    PYTHONPATH="${PYTHONPATH:-$stack_dir}:$dir" python3 -B "$dir/telegram_provision.py" channel "$TELEGRAM_DATA"
    echo 'Dedicated Constellation Instance is ready. Run telegram sign-in.'
    ;;
  sign-in)
    [[ ! -e "$TELEGRAM_DATA/connector/relocation-drain" ]] || { echo 'Finish the pending Telegram Agent move first.' >&2; exit 1; }
    [[ ! -e "$TELEGRAM_DATA/engine-moved" ]] || { echo 'Use host configure telegram-agent on the active worker.' >&2; exit 1; }
    [[ $# == 1 || ( $# == 2 && $2 == --reauthenticate ) ]] || { echo 'Use telegram sign-in [--reauthenticate].' >&2; exit 2; }
    [[ -t 0 && -t 1 ]] || { echo 'Run telegram sign-in from an interactive terminal.' >&2; exit 2; }
    shift
    if [[ $# == 1 ]]; then
      configured_model=$(python3 -B -c 'import json, sys; print(json.load(open(sys.argv[1]))["model"])' \
        "$TELEGRAM_DATA/connector/config.json")
      export TELEGRAM_MODEL="$configured_model"
      "${compose[@]}" --profile agent up -d --no-deps --build --wait --wait-timeout 120 telegram-engine
    fi
    "${compose[@]}" --profile agent exec telegram-engine /opt/amplifier-acp/.venv/bin/python -B /opt/telegram/sign_in.py "$@"
    if [[ $# == 1 ]]; then
      rm -f -- "$TELEGRAM_DATA/connector/backend-verified"
      "${compose[@]}" --profile agent restart telegram-engine
      "${compose[@]}" --profile agent up -d --no-deps --wait --wait-timeout 120 telegram-engine
    fi
    ;;
  probe)
    "${compose[@]}" --profile agent run --rm --no-deps --build connector probe
    ;;
  start-agent)
    [[ -s "$TELEGRAM_DATA/connector/backend-verified" ]] || { echo 'Run telegram probe first.' >&2; exit 1; }
    [[ -s "$TELEGRAM_DATA/guide/space-db" ]] || { echo 'Activate Telegram Bridge first.' >&2; exit 1; }
    "${stack[@]}" exec -T postgres psql -qX --set ON_ERROR_STOP=1 -U synapse -d matrix_telegram < "$dir/audit.sql"
    "${compose[@]}" --profile agent up -d --no-deps --build --wait --wait-timeout 60 connector
    ;;
  restart-connector)
    "${compose[@]}" --profile agent up -d --no-deps --build --force-recreate connector
    ;;
  upgrade-connector)
    [[ $# == 1 && -s "$TELEGRAM_DATA/connector/backend-verified" ]]
    "${compose[@]}" --profile agent up -d --wait --wait-timeout 60 --no-deps --build connector
    ;;
  dot-control)
    [[ $# == 2 ]]
    PYTHONPATH="${PYTHONPATH:-$stack_dir}:$dir" python3 -B "$dir/telegram_provision.py" dot-control "$TELEGRAM_DATA" "${TELEGRAM_DOT_STATE:-/srv/agents/dot/state}" "$2"
    ;;
  bind|rotate)
    [[ $# == 2 && -f "$2" ]] || { echo 'Use telegram bind|rotate PRIVATE_BINDING_JSON' >&2; exit 2; }
    binding=$(python3 -B - "$2" <<'PYTHON'
import json
from pathlib import Path
import re
import sys
name = json.loads(Path(sys.argv[1]).read_text())['id']
if not re.fullmatch(r'[a-z][a-z0-9-]{0,39}', name):
    raise SystemExit('Invalid binding name.')
print(f'binding-{name}.json')
PYTHON
)
    install -m 0600 -o 991 -g 991 "$2" "$TELEGRAM_DATA/connector/$binding"
    "${compose[@]}" --profile agent run --rm --no-deps connector "$1" "$binding"
    if [[ $1 == bind ]]; then
      PYTHONPATH="${PYTHONPATH:-$stack_dir}:$dir" python3 -B "$dir/telegram_provision.py" add-to-space "$TELEGRAM_DATA" "$binding"
    fi
    ;;
  arm-resume)
    [[ $# == 1 ]]
    rm -f -- "$TELEGRAM_DATA/connector/paused"
    echo 'External pause cleared. Run telegram resume after verifying the current deployment and outbox.'
    ;;
  report|resume)
    "${compose[@]}" --profile agent run --rm --no-deps connector "$1"
    ;;
  pause-binding)
    [[ $# == 2 ]]
    "${compose[@]}" --profile agent run --rm --no-deps connector pause "$2"
    ;;
  backup|restore-check)
    [[ $# == 1 ]]
    operation=capture
    if [[ $1 == restore-check ]]; then operation=verify; fi
    bash "$dir/backup" "$dir" "$stack_dir" "$operation"
    ;;
  enable-operations)
    [[ $# == 1 ]]
    bash "$dir/systemd-units" "$dir"
    ;;
  metrics)
    [[ $# == 1 ]]
    "${compose[@]}" --profile agent ps -a --format json | python3 -B "$dir/metrics.py"
    ;;
  status)
    "${compose[@]}" --profile agent ps
    ;;
  pause)
    : > "$TELEGRAM_DATA/connector/paused"
    echo 'Telegram agent publication is paused. Inspect in-flight operations before resuming.'
    ;;
  deactivate)
    : > "$TELEGRAM_DATA/connector/paused"
    "${compose[@]}" --profile agent stop connector telegram-engine telegram-bridge
    rm -f -- "$TELEGRAM_DATA/guide/space-db"
    "${config[@]}" disable "$TELEGRAM_DATA"
    "${stack[@]}" restart synapse
    ;;
  *) echo 'Use telegram prepare|activate|allow|disallow|prepare-agent|sign-in|probe|start-agent|bind|rotate|report|arm-resume|resume|pause|pause-binding|backup|restore-check|metrics|enable-operations|status|deactivate.' >&2; exit 2 ;;
esac
