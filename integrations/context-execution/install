#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
[[ $EUID == 0 ]] || { echo 'Run this command from the VPS root console.' >&2; exit 1; }
release=$(cd -- "$(dirname -- "$0")" && pwd)
pilot=/opt/matrix-agents/chief-of-staff
state=/srv/agents/chief-of-staff
export COS_MEMORY_STATE=$state/memory COMPOSE_IGNORE_ORPHANS=true COMPOSE_REMOVE_ORPHANS=false
set -a
. /opt/matrix-stack/.env
. /opt/matrix-agents/.env
set +a
compose=(docker compose -f "$pilot/memory/compose.yaml")
bridge=(docker compose -f "$pilot/direct/compose.yaml")
base=matrix-context-intelligence:6.13.0-1622b48
image=matrix-context-intelligence:6.13.0-execution-v2
old_context=matrix-context_context-intelligence-data
old_neo4j=matrix-context_context-intelligence-neo4j-data
new_context=matrix-context_context-intelligence-v2-data
new_neo4j=matrix-context_context-intelligence-v2-neo4j-data
exec 9>"$state/operator.lock"
flock -n 9 || { echo 'Chief of Staff is busy. Wait for the current operation to finish.' >&2; exit 1; }

if [[ ${1:-} == purge-previous && $# == 2 ]]; then
  saved=$2
  [[ $saved =~ ^/srv/agents/chief-of-staff/execution-previous\.[A-Za-z0-9]{8}$ && -f $saved/verified && ! -L $saved ]]
  current=$("${compose[@]}" ps --status running --quiet context)
  neo=$("${compose[@]}" ps --status running --quiet neo4j)
  [[ -n $current && -n $neo ]]
  [[ $(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' "$current") == "$new_context" ]]
  [[ $(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' "$neo") == "$new_neo4j" ]]
  for volume in "$old_context" "$old_neo4j"; do
    if docker volume inspect "$volume" >/dev/null 2>&1; then docker volume rm "$volume"; fi
  done
  rm -rf -- "$saved/direct"
  echo 'Discarded detached Context Intelligence volumes and the previous observation cache.'
  exit
fi

[[ ${1:-} == cutover && $# == 1 ]] || { echo 'Use install cutover or install purge-previous SAVED_DIRECTORY.' >&2; exit 1; }
[[ -f $state/direct/agents-room-id && -f $state/direct/installed && ! -L $state/direct ]]
docker volume inspect "$old_context" "$old_neo4j" >/dev/null
for name in "$new_context" "$new_neo4j"; do
  if docker volume inspect "$name" >/dev/null 2>&1; then
    echo "The new-generation volume already exists: $name" >&2
    exit 1
  fi
done
echo 'Current Context Intelligence network members:'
docker network inspect -f '{{range .Containers}}{{println .Name}}{{end}}' matrix-context_memory

saved=$(mktemp -d "$state/execution-previous.XXXXXXXX")
cp -p -- "$pilot/memory/compose.yaml" "$saved/compose.yaml"
cp -p -- "$pilot/memory/snapshot" "$saved/snapshot"
cp -p -- "$pilot/direct/evidence.mjs" "$saved/evidence.mjs"
cp -p -- "$pilot/direct/bridge.mjs" "$saved/bridge.mjs"
cp -p -- /opt/matrix-stack/context_disk.py "$saved/context_disk.py"
python3 -B - "$saved/bridge.mjs" "$saved/replacement-bridge.mjs" <<'PY'
from pathlib import Path
import sys
src, dst = map(Path, sys.argv[1:])
source = src.read_text()
old = 'entry = interaction(source, clear, user);'
new = 'entry = interaction(source, clear, user, owner);'
if source.count(old) != 1:
    raise SystemExit('Unexpected Chief of Staff reader layout')
dst.write_text(source.replace(old,new,1))
PY
docker build --pull=false -t "$image" "$release"
docker run --rm --network none --entrypoint /app/.venv/bin/python "$image" \
  -c 'from context_intelligence_server.main import app; from context_intelligence_server.execution_timeline import execution_ids; assert app and execution_ids({"trace_id":"smoke","task_id":"smoke"})'
python3 -B "$release/prepare.py" "$saved/compose.yaml" "$saved/replacement.yaml" \
  "$(date +%s%3N)" "$COS_MEMORY_STATE/server.json"

rollback() {
  local status=$?
  trap - ERR
  set +e
  "${bridge[@]}" stop chief-of-staff
  "${compose[@]}" stop context neo4j
  for file in compose.yaml snapshot; do cp -p -- "$saved/$file" "$pilot/memory/$file"; done
  for file in evidence.mjs bridge.mjs; do cp -p -- "$saved/$file" "$pilot/direct/$file"; done
  cp -p -- "$saved/context_disk.py" /opt/matrix-stack/context_disk.py
  if [[ -d $saved/direct ]]; then
    if [[ -d $state/direct ]]; then mv -- "$state/direct" "$saved/failed-direct"; fi
    mv -- "$saved/direct" "$state/direct"
  fi
  "${compose[@]}" up -d --no-build --wait --wait-timeout 120 neo4j context
  "${bridge[@]}" up -d --no-build --wait --wait-timeout 120 chief-of-staff
  systemctl restart matrix-monitor.service
  echo "Cutover stopped. Previous files restored from $saved." >&2
  exit "$status"
}
trap rollback ERR
"${bridge[@]}" stop --timeout 30 chief-of-staff
"${compose[@]}" stop --timeout 60 context
"${compose[@]}" stop --timeout 60 neo4j
install -m 0644 "$saved/replacement.yaml" "$pilot/memory/compose.yaml"
install -m 0755 "$release/snapshot" "$pilot/memory/snapshot"
install -m 0644 "$release/context_disk.py" /opt/matrix-stack/context_disk.py
install -m 0644 "$release/evidence.mjs" "$pilot/direct/evidence.mjs"
install -m 0644 "$saved/replacement-bridge.mjs" "$pilot/direct/bridge.mjs"
"${compose[@]}" create --no-build neo4j context
docker run --rm --network none --user 0 --entrypoint /bin/sh \
  --mount "type=volume,src=$old_context,dst=/previous,readonly" \
  --mount "type=volume,src=$new_context,dst=/data" "$base" -ec '
    if [ -f /previous/identity/api-keys.json ]; then
      install -d -m 0700 -o 991 -g 991 /data/identity
      install -m 0600 -o 991 -g 991 /previous/identity/api-keys.json /data/identity/api-keys.json
      cmp -s /previous/identity/api-keys.json /data/identity/api-keys.json
    fi'
mv -- "$state/direct" "$saved/direct"
install -d -m 0700 -o 991 -g 991 "$state/direct" "$state/direct/outbox"
cp -p -- "$saved/direct/"{agents-room-id,installed} "$state/direct/"
"${compose[@]}" up -d --no-build --wait --wait-timeout 150 neo4j context
docker run --rm --network matrix-context_memory --user 991:991 --read-only \
  --mount "type=bind,src=$COS_MEMORY_STATE/reader-token,dst=/reader-token,readonly" \
  --entrypoint /app/.venv/bin/python "$image" -c '
import json, urllib.request
token = open("/reader-token").read().strip()
request = urllib.request.Request("http://context:8000/cypher", method="POST", headers={"Authorization":"Bearer " + token,"Content-Type":"application/json"}, data=json.dumps({"workspace":"agents-team","query":"MATCH (n:Event {workspace:$workspace}) RETURN count(n) AS events"}).encode())
with urllib.request.urlopen(request, timeout=12) as response:
    rows=json.load(response)["results"]
assert rows == [{"events":0}], rows
print("The new memory is empty and the existing reader credential works.")'
"${bridge[@]}" up -d --no-build --wait --wait-timeout 120 chief-of-staff
systemctl restart matrix-monitor.service
touch "$saved/verified"
trap - ERR
printf 'Context Intelligence execution timeline is active. Previous volumes are detached. Previous state: %s\n' "$saved"
