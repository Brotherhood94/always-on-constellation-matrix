#!/usr/bin/env bash
set -Eeuo pipefail
src=$(cd -- "$(dirname -- "$0")/.." && pwd)
name="constellation-layout-$$"
image=ghcr.io/element-hq/synapse:v1.165.0
cleanup() {
  docker rm -f "$name" >/dev/null 2>&1 || true
  docker volume rm "$name" >/dev/null 2>&1 || true
  docker network rm "$name" >/dev/null 2>&1 || true
  if [[ -n ${desk_tls:-} ]]; then rm -rf -- "$desk_tls"; fi
}
trap cleanup EXIT
docker volume create "$name" >/dev/null
docker network create --internal "$name" >/dev/null
docker run --rm -i --network none -v "$name:/data" --entrypoint python "$image" - <<'PY'
from pathlib import Path
import json
import subprocess
import yaml

path = Path('/data/homeserver.yaml')
subprocess.run(['python', '-m', 'synapse.app.homeserver', '--server-name', 'fixture.test', '--config-path',
                str(path), '--generate-config', '--report-stats=no', '--data-directory', '/data'], check=True, capture_output=True)
config = yaml.safe_load(path.read_text())
config.update(listeners=[{'type': 'http', 'port': 8008, 'tls': False, 'resources': [{'names': ['client']}]}],
              registration_shared_secret='synthetic-test-registration-secret',
              rc_message={'per_second': 25, 'burst_count': 100},
              rc_room_creation={'per_second': 25, 'burst_count': 100},
              rc_login={'address': {'per_second': 50, 'burst_count': 50}, 'account': {'per_second': 50, 'burst_count': 50}})
path.write_text(json.dumps(config))
PY
docker run -d --name "$name" --network "$name" --network-alias synapse -v "$name:/data" -v "$src/deploy:/deploy:ro" \
  -v "$src/integrations/telegram:/telegram:ro" \
  -v "$src:/workspace:ro" \
  -v "$src/tests/layout_check.py:/test.py:ro" --entrypoint python "$image" \
  -m synapse.app.homeserver -c /data/homeserver.yaml >/dev/null
for attempt in {1..30}; do
  if docker exec "$name" curl -fsS http://127.0.0.1:8008/_matrix/client/versions >/dev/null 2>&1; then break; fi
  sleep 1
done
docker exec -e MATRIX_SERVER_NAME=fixture.test -e MATRIX_LOCAL_PORT=8008 \
  -e MATRIX_REGISTRATION_SECRET=synthetic-test-registration-secret -e PYTHONPATH=/deploy:/telegram \
  "$name" python -B /test.py
if [[ ${MATRIX_OPERATIONS_SMOKE:-0} == 1 ]]; then
  mounts=(--tmpfs /welcome)
  if [[ -n ${MATRIX_TOPOLOGY_DIR:-} ]]; then
    mounts+=(-v "$MATRIX_TOPOLOGY_DIR:/topology" -e 'MATRIX_TOPOLOGY_EVIDENCE=/topology/office-evidence.json')
  fi
  docker run --rm --network "$name" --user 0:0 --entrypoint node \
    "${mounts[@]}" -v "$src/agents/connector/welcome.mjs:/app/welcome.mjs:ro" \
    -v "$src/integrations/chief-of-staff:/app/chief-of-staff:ro" \
    -v "$src/deploy/retire-worker.sql:/app/retire-worker.sql:ro" \
    -v "$src/deploy/matrix/bot:/app/ops:ro" -v "$src/tests/operations-fixture.mjs:/app/operations.mjs:ro" \
    "${MATRIX_CONNECTOR_TEST_IMAGE:-constellation-office-connector:0.22.17}" /app/operations.mjs
fi
docker exec -u 0 -e MATRIX_SERVER_NAME=fixture.test -e MATRIX_LOCAL_PORT=8008 \
  -e MATRIX_REGISTRATION_SECRET=synthetic-test-registration-secret -e PYTHONPATH=/workspace/deploy -e MATRIX_HELPER_SMOKE="${MATRIX_HELPER_SMOKE:-0}" \
  "$name" python -B /workspace/tests/team_migration_fixture.py
if [[ ${MATRIX_HELPER_SMOKE:-0} == 1 ]]; then
  desk_tls=$(mktemp -d)
  openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost \
    -keyout "$desk_tls/key.pem" -out "$desk_tls/cert.pem" >/dev/null 2>&1
  docker run --rm --network "$name" --user 0:0 --entrypoint node \
    -v "$name:/fixture:ro" -v "$desk_tls:/helper-tls:ro" -v "$src/tests/helper-fixture.mjs:/app/helper-fixture.mjs:ro" \
    -v "$src/agents/connector/helper-dm.mjs:/app/helper-dm.mjs:ro" \
    -v "$src/agents/connector/move-probe.mjs:/app/move-probe.mjs:ro" \
    -v "$src/agents/connector/helper-support.mjs:/app/helper-support.mjs:ro" \
    -v "$src/agents/connector/connector.mjs:/app/connector.mjs:ro" \
    -v "$src/agents/connector/agent-catalog.mjs:/app/agent-catalog.mjs:ro" \
    -v "$src/agents/connector/capability-dispatch.mjs:/app/capability-dispatch.mjs:ro" \
    "${MATRIX_CONNECTOR_TEST_IMAGE:-constellation-office-connector:0.22.17}" /app/helper-fixture.mjs
  rm -rf -- "$desk_tls"
  unset desk_tls
fi
if [[ ${MATRIX_OPERATIONS_SMOKE:-0} == 1 || ${MATRIX_TEAM_DESKS_SMOKE:-0} == 1 ]]; then
  desk_tls=$(mktemp -d)
  openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=localhost -addext subjectAltName=DNS:localhost \
    -keyout "$desk_tls/key.pem" -out "$desk_tls/ca.pem" >/dev/null 2>&1
  docker run --rm --network "$name" --network-alias context --user 0:0 --entrypoint node \
    -v "$desk_tls:/desk-tls:ro" \
    -v "$src/integrations/chief-of-staff:/app/chief-of-staff:ro" \
    -v "$src/tests/team-desks-fixture.mjs:/app/team-desks-fixture.mjs:ro" \
    "${MATRIX_CONNECTOR_TEST_IMAGE:-constellation-office-connector:0.22.17}" /app/team-desks-fixture.mjs
fi
