  -v "$root/agents/engine/amplifier_module_provider_constellation_hiring:/opt/amplifier-acp/.venv/lib/python3.13/site-packages/amplifier_module_provider_constellation_hiring:ro" \
  -v "$root/agents/engine/connect-plan.py.lock:/opt/office/connect-plan.py.lock:ro" \
  -v "$root/agents/engine/launch-plan.sh:/opt/office/launch-plan.sh:ro" \
