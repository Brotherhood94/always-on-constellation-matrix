root=$(cd -- "$(dirname -- "$0")/.." && pwd)
docker run --rm -i --network none --add-host hiring-provider:127.0.0.1 --read-only --tmpfs /tmp \
  --tmpfs /instance:uid=991,gid=991,mode=0700 --tmpfs /hiring-agent:uid=991,gid=991,mode=0700 \
