FROM docker:28.5.2-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d AS docker_cli
FROM restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76 AS backup_cli
FROM python:3.13-slim-bookworm@sha256:f0fa218d5b06f9b9235024fa061cde2cb141f726de52134471053d2d9b5324a3
COPY --from=docker_cli /usr/local/bin/docker /usr/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY --from=backup_cli /usr/bin/restic /usr/bin/restic
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git openssl coreutils findutils util-linux \
    && rm -rf /var/lib/apt/lists/*
